/* =============================================================================
   ADMIN DATA BUILD  (GENERATED by tools/gen_paste.py - edit Src, not this file)
   The OnSelect of btnRefreshOverview (scrOverview) and btnRefreshSubs
   (scrSubmissions). Both buttons carry exactly this text; each screen's
   OnVisible presses its button with Select(). Leading '=' already removed.

   Admins get every row on People; a line manager only the rows whose
   LineManagerEmail is their own (lower-case) address. Needs the
   LineManagerEmail column on 'RolePreference People' and all six tables.
   ============================================================================ */
Refresh('RolePreference People');
Refresh('RolePreference Preferences');
Refresh('RolePreference PreferenceResponses');
Refresh('RolePreference Roles');
Refresh('RolePreference Alignments');
ClearCollect(colAllRoles, ForAll('RolePreference Roles' As r, {Key: r.RoleKey, Name: r.RoleName}));
ClearCollect(
    colAllStaff,
    ForAll(
        If(varIsAdmin, 'RolePreference People', Filter('RolePreference People', LineManagerEmail = varUserEmail)) As p,
        With(
            {a: LookUp('RolePreference Alignments', EmployeeID = p.EmployeeID)},
            With(
                {s1: LookUp('RolePreference Preferences', EmployeeID = p.EmployeeID And Stage1Status <> "Withdrawn")},
                With(
                    {s2: CountRows(Filter('RolePreference PreferenceResponses', EmployeeID = p.EmployeeID And Stage2Status = "Submitted")) > 0},
                    With(
                        {done: a.AlignmentStatus = "Submitted", rej: a.AlignmentStatus = "Submitted" And a.Decision = "Rejected"},
                        {EmpId: p.EmployeeID, Name: p.Name, Grade: p.Grade, Area: p.Area
                            , Stage12: If(s2, "Completed", Not IsBlank(s1), "In progress", "Not started")
                            , SubmittedOn: If(IsBlank(s1), "", Text(s1.SubmittedOn, "dd/mm/yyyy"))
                            , AlignedRole: Coalesce(a.AssignedRoleName, LookUp(colAllRoles, Key = a.AssignedRoleKey).Name, "")
                            , Status: If(rej, "Role rejected", done And a.Decision = "Accepted", "Role accepted"
                                , IsBlank(Coalesce(a.AssignedRoleName, a.AssignedRoleKey)), "No role yet", "Awaiting response")
                            , Reasons: If(rej, a.RejectReasons, ""), Comments: If(rej, a.RejectComments, "")
                            , DecidedOn: If(done, Text(a.DecisionOn, "dd/mm/yyyy"), ""), DecidedSort: If(done, Text(a.DecisionOn, "yyyy-mm-dd hh:mm"), "")}
                    )
                )
            )
        )
    )
);
Set(varCountAll, CountRows(colAllStaff));
Set(varCountAccepted, CountRows(Filter(colAllStaff, Status = "Role accepted")));
Set(varCountRejected, CountRows(Filter(colAllStaff, Status = "Role rejected")));
Set(varCountAwaiting, varCountAll - varCountAccepted - varCountRejected);
ClearCollect(
    colOverviewRows,
    ForAll(
        Filter(colAllStaff, Stage12 <> "Not started") As d,
        With(
            {k1: LookUp('RolePreference Preferences', EmployeeID = d.EmpId And Rank = 1).RoleKey},
            With(
                {k2: LookUp('RolePreference Preferences', EmployeeID = d.EmpId And Rank = 2).RoleKey},
                With(
                    {k3: LookUp('RolePreference Preferences', EmployeeID = d.EmpId And Rank = 3).RoleKey},
                    With(
                        {dt: LookUp('RolePreference Preferences', EmployeeID = d.EmpId).SubmittedOn},
                        {Id: d.EmpId, EmpId: d.EmpId, Name: d.Name, Grade: d.Grade, Area: d.Area, Stage12: d.Stage12
                            , Date: Text(dt, "dd/mm/yyyy"), SortDateText: Text(dt, "yyyy-mm-dd hh:mm")
                            , AlignedRole: d.AlignedRole, Status: d.Status, Reasons: d.Reasons, Comments: d.Comments
                            , DecidedOn: d.DecidedOn, DecidedSort: d.DecidedSort
                            , R1Name: If(IsBlank(k1), Blank(), Coalesce(LookUp(colAllRoles, Key = k1).Name, "[missing role: " & k1 & "]"))
                            , R1a: LookUp('RolePreference PreferenceResponses', EmployeeID = d.EmpId And RoleKey = k1 And QIndex = 0).ResponseText
                            , R1b: LookUp('RolePreference PreferenceResponses', EmployeeID = d.EmpId And RoleKey = k1 And QIndex = 1).ResponseText
                            , R2Name: If(IsBlank(k2), Blank(), Coalesce(LookUp(colAllRoles, Key = k2).Name, "[missing role: " & k2 & "]"))
                            , R2a: LookUp('RolePreference PreferenceResponses', EmployeeID = d.EmpId And RoleKey = k2 And QIndex = 0).ResponseText
                            , R2b: LookUp('RolePreference PreferenceResponses', EmployeeID = d.EmpId And RoleKey = k2 And QIndex = 1).ResponseText
                            , R3Name: If(IsBlank(k3), Blank(), Coalesce(LookUp(colAllRoles, Key = k3).Name, "[missing role: " & k3 & "]"))
                            , R3a: LookUp('RolePreference PreferenceResponses', EmployeeID = d.EmpId And RoleKey = k3 And QIndex = 0).ResponseText
                            , R3b: LookUp('RolePreference PreferenceResponses', EmployeeID = d.EmpId And RoleKey = k3 And QIndex = 1).ResponseText}
                    )
                )
            )
        )
    )
);
ClearCollect(colAreaOptions, {Value: "All areas"});
Collect(colAreaOptions, ForAll(Sort(Distinct(Filter(colAllStaff, Not IsBlank(Area)), Area), Value, SortOrder.Ascending) As ar, {Value: ar.Value}));
Set(varAdminRefreshedAt, Text(Now(), "HH:mm:ss"))
