/* =============================================================================
   PHASE 2 — ROLE ALIGNMENT: the button formulas (formula-bar paste)
   Select the named control in Studio, pick OnSelect, replace the ENTIRE
   formula with the block below (the leading '=' is already stripped).

   These are ALSO baked into the pasted YAML for scrAlignment / scrRejection,
   so a clean paste needs no manual step here. Keep this file as the reference
   copy: if a formula ever has to be re-typed, or Studio mangles one on paste,
   this is what it should say. (Extracted from Src/ - edit the screen, not
   this file, and copy across.)

   MODEL: one row per person on 'RolePreference Alignments'.
     AlignmentStatus blank        a role is published, nobody has responded
     AlignmentStatus "Draft"      a rejection is part-written and still editable
     AlignmentStatus "Submitted"  locked - scrAlignLocked is the only view now
   Only the two confirm buttons set "Submitted"; Save draft never does.

   PREREQUISITES:
     - a LineManagerEmail text column (100) on 'RolePreference Alignments';
     - the Office 365 Outlook connector, for the two hidden email buttons only.
   ============================================================================ */

/* ---------- scrAlignment > btnAcceptRole ('Accept role') ---------------
   Gate only - opens the confirmation overlay. Refuses, with an error, until
   the line manager's email has been typed twice (matching, a valid address,
   not the person's own) and the line-manager conversation box is ticked.
   Stores the address in varAlignLmEmail for the confirm buttons. */
With(
    {e1: Lower(Trim(aliLmEmail.Text)), e2: Lower(Trim(aliLmEmail2.Text))},
    If(
        Not IsMatch(e1, Match.Email),
        UpdateContext({locLmEmailMissed: true});
        Notify("Please enter your line manager's email address.", NotificationType.Error),
        e1 <> e2,
        UpdateContext({locLmEmailMissed: true});
        Notify("The two line manager email addresses do not match. Please check them.", NotificationType.Error),
        e1 = varUserEmail,
        UpdateContext({locLmEmailMissed: true});
        Notify("Please enter your line manager's email address, not your own.", NotificationType.Error),
        Not locLmConfirmed,
        UpdateContext({locConfirmMissed: true});
        Notify("Please confirm you have had a conversation with your line manager before you accept or reject this role.", NotificationType.Error),
        Not varAlignPublished,
        Notify("Your aligned role has not loaded, so this cannot be submitted yet. Close and reopen the app, and contact Aurora if it still does not appear.", NotificationType.Error),
        Set(varAlignLmEmail, e1);
        UpdateContext({locShowAccept: true})
    )
)

/* ---------- scrAlignment > btnRejectRole ('Reject role') ---------------
   Same gate as Accept, then goes to the rejection page. */
With(
    {e1: Lower(Trim(aliLmEmail.Text)), e2: Lower(Trim(aliLmEmail2.Text))},
    If(
        Not IsMatch(e1, Match.Email),
        UpdateContext({locLmEmailMissed: true});
        Notify("Please enter your line manager's email address.", NotificationType.Error),
        e1 <> e2,
        UpdateContext({locLmEmailMissed: true});
        Notify("The two line manager email addresses do not match. Please check them.", NotificationType.Error),
        e1 = varUserEmail,
        UpdateContext({locLmEmailMissed: true});
        Notify("Please enter your line manager's email address, not your own.", NotificationType.Error),
        Not locLmConfirmed,
        UpdateContext({locConfirmMissed: true});
        Notify("Please confirm you have had a conversation with your line manager before you accept or reject this role.", NotificationType.Error),
        Not varAlignPublished,
        Notify("Your aligned role has not loaded, so there is nothing to reject yet. Close and reopen the app, and contact Aurora if it still does not appear.", NotificationType.Error),
        Set(varAlignLmEmail, e1);
        Navigate(scrRejection)
    )
)

/* ---------- scrAlignment > btnConfirmAccept ('Yes, accept role' — FINAL) ----
   Clears any rejection draft, saves the decision and the line manager's email.
   Nothing is locked or emailed unless the Patch succeeds. Then presses the
   hidden btnEmailAccept, which sends the confirmation. */
If(
    IsError(
        Patch(
            'RolePreference Alignments',
            LookUp('RolePreference Alignments', EmployeeID = varUser.EmpId),
            {Decision: "Accepted", RejectReasons: "", RejectComments: "", AlignmentStatus: "Submitted", DecisionOn: Now(), DecisionBy: User().Email, LineManagerEmail: varAlignLmEmail}
        )
    ),
    Notify("Your response could not be saved, so nothing has been sent. Please try again, and contact aurora@environment-agency.gov.uk if it keeps happening.", NotificationType.Error),
    Set(varAlignDecision, "Accepted");
    Set(varAlignReasonsText, "");
    Set(varAlignComments, "");
    Set(varAlignStatus, "Submitted");
    Set(varAlignSubmitted, true);
    Set(varAlignDate, Text(Now(), "dd/mm/yyyy"));
    Select(btnEmailAccept);
    UpdateContext({locShowAccept: false});
    Navigate(scrAlignLocked)
)

/* ---------- scrAlignment > btnEmailAccept (hidden — sends the confirmation email) ----
   Its own control so a connector problem (Office 365 Outlook not added, or an
   action the organisation has blocked) can only break this formula, not the
   save. Cc = Aurora + the line manager the person typed in. */
IfError(
    Office365Outlook.SendEmailV2(
        varUserEmail,
        "Aurora role alignment — " & varUser.Name & " has accepted their aligned role",
        Substitute(varEmailAccepted, "{{DATE}}", varAlignDate),
        {Cc: "aurora@environment-agency.gov.uk" & If(IsBlank(varAlignLmEmail), "", ";" & varAlignLmEmail), Importance: "Normal"}
    ),
    Notify("Your response has been saved, but the confirmation email could not be sent. Please let aurora@environment-agency.gov.uk know.", NotificationType.Warning)
)

/* ---------- scrRejection > btnSaveRejDraft ('Save draft') --------------
   Refuses to write while the comments are over 150 words. AlignmentStatus
   stays "Draft" and Decision is untouched, so the person can come back and
   still accept instead. Also records the line manager's email. */
If(
    CountRows(Filter(Split(Substitute(Substitute(rejTxt.Text, Char(10), " "), Char(13), " "), " "), Len(Trim(Value)) > 0)) > 150,
    Notify("Your comments are over the 150-word limit. Shorten them and try again.", NotificationType.Error),
    Patch(
        'RolePreference Alignments',
        LookUp('RolePreference Alignments', EmployeeID = varUser.EmpId),
        {RejectReasons: Concat(Filter(colRejectReasons, Chosen) As c, c.Reason, "; "), RejectComments: rejTxt.Text, AlignmentStatus: "Draft", LineManagerEmail: varAlignLmEmail}
    );
    Set(varAlignReasonsText, Concat(Filter(colRejectReasons, Chosen) As c, c.Reason, "; "));
    Set(varAlignComments, rejTxt.Text);
    Set(varAlignStatus, "Draft")
);
Set(varAlignDraftSaved, CountRows(Filter(Split(Substitute(Substitute(rejTxt.Text, Char(10), " "), Char(13), " "), " "), Len(Trim(Value)) > 0)) <= 150)

/* ---------- scrRejection > btnSubmitReject ('Submit') ------------------
   Gate only - opens the confirmation overlay. Errors, and stops, when no reason
   is ticked, the text box is empty, or the text is over 150 words. */
If(
    CountRows(Filter(colRejectReasons, Chosen)) = 0,
    Notify("Please choose at least one reason before you submit.", NotificationType.Error),
    Len(Trim(rejTxt.Text)) = 0,
    Notify("Please provide further information in the text box before you submit.", NotificationType.Error),
    CountRows(Filter(Split(Substitute(Substitute(rejTxt.Text, Char(10), " "), Char(13), " "), " "), Len(Trim(Value)) > 0)) > 150,
    Notify("Your further information is over the 150-word limit. Please shorten it before you submit.", NotificationType.Error),
    UpdateContext({locShowReject: true})
)

/* ---------- scrRejection > btnConfirmReject ('Yes, submit' — FINAL) ----
   The ticked reasons are stored as one ";"-separated string, so a reason must
   never contain a semicolon. Same save-then-email pattern as
   btnConfirmAccept; returns to the homepage. */
If(
    IsError(
        Patch(
            'RolePreference Alignments',
            LookUp('RolePreference Alignments', EmployeeID = varUser.EmpId),
            {Decision: "Rejected", RejectReasons: Concat(Filter(colRejectReasons, Chosen) As c, c.Reason, "; "), RejectComments: rejTxt.Text
                , AlignmentStatus: "Submitted", DecisionOn: Now(), DecisionBy: User().Email, LineManagerEmail: varAlignLmEmail}
        )
    ),
    Notify("Your response could not be saved, so nothing has been sent. Please try again, and contact aurora@environment-agency.gov.uk if it keeps happening.", NotificationType.Error),
    Set(varAlignDecision, "Rejected");
    Set(varAlignReasonsText, Concat(Filter(colRejectReasons, Chosen) As c, c.Reason, "; "));
    Set(varAlignComments, rejTxt.Text);
    Set(varAlignStatus, "Submitted");
    Set(varAlignSubmitted, true);
    Set(varAlignDate, Text(Now(), "dd/mm/yyyy"));
    Set(varAlignDraftSaved, false);
    UpdateContext({locShowReject: false});
    Notify("Your response has been submitted.", NotificationType.Success);
    Select(btnEmailReject);
    Navigate(scrLanding)
)

/* ---------- scrRejection > btnEmailReject (hidden — sends the confirmation email) ----
   {{REASONS}} becomes one <li> per ticked reason; {{COMMENTS}} is the
   further-information text with & < > escaped and line breaks kept. */
IfError(
    Office365Outlook.SendEmailV2(
        varUserEmail,
        "Aurora role alignment — " & varUser.Name & " has rejected their aligned role",
        Substitute(
            Substitute(
                Substitute(varEmailRejected, "{{DATE}}", varAlignDate),
                "{{REASONS}}", "<li>" & Substitute(varAlignReasonsText, "; ", "</li><li>") & "</li>"
            ),
            "{{COMMENTS}}", Substitute(Substitute(Substitute(Substitute(Substitute(varAlignComments, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), Char(13), ""), Char(10), "<br>")
        ),
        {Cc: "aurora@environment-agency.gov.uk" & If(IsBlank(varAlignLmEmail), "", ";" & varAlignLmEmail), Importance: "Normal"}
    ),
    Notify("Your response has been submitted, but the confirmation email could not be sent. Please let aurora@environment-agency.gov.uk know.", NotificationType.Warning)
)

/* ---------- IF Concat(... As c, c.Reason, "; ") IS REJECTED -----------------
   Some builds refuse the As alias on Concat. The un-aliased form works because
   Reason resolves in Concat's implicit row scope:
       Concat(Filter(colRejectReasons, Chosen), Reason, "; ")
   Swap it everywhere above (and in the two pasted screens) if the formula bar
   flags the aliased version. */
