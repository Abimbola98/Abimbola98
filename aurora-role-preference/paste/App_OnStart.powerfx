/* ===================================================================
   1) IDENTITY  — replace the literal record with the People lookup:
      Set(varUser, LookUp(People, 'Email/UPN' = User().Email))
   =================================================================== */
Set(
    varUser,
    {
        Name: "S. Patel",
        EmpId: "60412",
        Grade: "SG6",
        Area: "Devon, Cornwall & Isles of Scilly",
        Team: "Area Programme",
        LastLogin: "24/06/2026 09:14"
    }
);

/* ADMIN GATE — stub. Wire to the real Office365Groups / config check, e.g.
   Set(varIsAdmin, !IsBlank(LookUp(Office365Groups.ListOwnedGroupsV2()...)))
   NOTE: in-app gating is NOT security — enforce row-level security on the
   Dataverse tables too (see README). */
Set(varIsAdmin, true);

/* ===================================================================
   2) ROLES  ->  Dataverse table: Roles
      Nested Responsibilities/Requirements are stored as inline tables so
      the detail-screen galleries can bind to them. In Dataverse these are
      rich-text / multiline fields — split on import as needed.
   =================================================================== */
ClearCollect(
    colRoles,
    {
        Key: "gov", Name: "Governance & Decision Support",
        Desc: "Boards, decisions and portfolio governance.", Full: true,
        Purpose: "Supports portfolio governance, decision-making boards and assurance of EA project delivery.",
        Responsibilities: Table({Item:"Board secretariat and preparation"},{Item:"Tracking decisions and actions"},{Item:"Supporting senior reporting"},{Item:"Liaison with delivery and finance teams"}),
        Requirements: Table({Item:"Experience of governance or PMO environments"},{Item:"Strong written communication"},{Item:"Comfort working with senior stakeholders"},{Item:"Attention to detail"}),
        GradeContext: "Typically SG6."
    },
    {
        Key: "perf", Name: "Performance & Reporting Control",
        Desc: "Delivery confidence, reporting and data management.", Full: true,
        Purpose: "Provides delivery confidence, performance reporting and data management across the area portfolio.",
        Responsibilities: Table({Item:"Producing portfolio performance and delivery-confidence reporting"},{Item:"Maintaining benefits and milestone trackers"},{Item:"Managing programme data quality and management information"},{Item:"Supporting forecasting and trend analysis for senior reviews"}),
        Requirements: Table({Item:"Strong analytical and data-handling skills"},{Item:"Confident with reporting tools and spreadsheets"},{Item:"Clear presentation of performance information"},{Item:"Attention to accuracy and detail"}),
        GradeContext: "Typically SG6."
    },
    {
        Key: "stake", Name: "Stakeholder Management",
        Desc: "Supplier and stakeholder relationships.", Full: true,
        Purpose: "Manages the supplier and stakeholder relationships that underpin successful delivery.",
        Responsibilities: Table({Item:"Building and maintaining key stakeholder and supplier relationships"},{Item:"Coordinating engagement and communications activity"},{Item:"Running contract and supplier review meetings"},{Item:"Resolving issues and escalations with delivery partners"}),
        Requirements: Table({Item:"Excellent interpersonal and communication skills"},{Item:"Experience managing external relationships"},{Item:"Negotiation and influencing ability"},{Item:"Comfort working across organisational boundaries"}),
        GradeContext: "Typically SG6."
    },
    {
        Key: "risk", Name: "Risk & Dependency Management",
        Desc: "Risk, issue and dependency registers.", Full: true,
        Purpose: "Maintains the risk, issue and dependency picture across the programme.",
        Responsibilities: Table({Item:"Maintaining risk, issue and dependency registers"},{Item:"Facilitating risk reviews and mitigation planning"},{Item:"Tracking cross-team dependencies"},{Item:"Reporting the risk position to governance boards"}),
        Requirements: Table({Item:"Experience of risk or PMO processes"},{Item:"Structured, methodical approach"},{Item:"Strong facilitation skills"},{Item:"Attention to detail"}),
        GradeContext: "Typically SG6 to SG5."
    },
    {
        Key: "res", Name: "Resource Management",
        Desc: "Resource demand and workload planning.", Full: true,
        Purpose: "Plans resource demand and balances workload across competing priorities.",
        Responsibilities: Table({Item:"Planning and forecasting resource demand"},{Item:"Balancing workload across teams and priorities"},{Item:"Maintaining capacity and allocation models"},{Item:"Supporting recruitment and onboarding planning"}),
        Requirements: Table({Item:"Experience of resource or capacity planning"},{Item:"Strong organisational skills"},{Item:"Confident with planning tools and data"},{Item:"Ability to manage competing demands"}),
        GradeContext: "Typically SG6 to G7."
    }
);

/* ===================================================================
   3) ROLE QUESTIONS  ->  Dataverse table: RoleQuestions
      RETAINED BUT CURRENTLY UNUSED. Workstream 7 (03.07.26) replaced the
      role-specific questions with two STANDARD questions asked for each
      of the TOP THREE preferences (see colAnswers builder below). This
      collection is kept so role-specific questions can be reinstated
      without re-plumbing.
   =================================================================== */
ClearCollect(
    colRoleQuestions,
    {RoleKey:"gov",  Order:1, Required:true, Text:"This role supports senior decision-making boards. Describe your experience preparing for or running governance boards."},
    {RoleKey:"gov",  Order:2, Required:true, Text:"What evidence shows your ability to manage portfolio-level governance and reporting?"},
    {RoleKey:"perf", Order:1, Required:true, Text:"This role focuses on delivery confidence, benefits tracking and data management. Describe relevant experience."},
    {RoleKey:"perf", Order:2, Required:true, Text:"Give an example of using performance data to influence a delivery decision."},
    {RoleKey:"stake",Order:1, Required:true, Text:"This role centres on supplier and stakeholder relationships. Describe your experience managing complex stakeholder relationships."},
    {RoleKey:"stake",Order:2, Required:true, Text:"Give an example of resolving a difficult supplier or stakeholder issue."},
    {RoleKey:"risk", Order:1, Required:true, Text:"This role maintains risk, issue and dependency registers. Describe your experience managing risks and dependencies on a programme."},
    {RoleKey:"risk", Order:2, Required:true, Text:"Give an example of identifying and mitigating a significant delivery risk."},
    {RoleKey:"res",  Order:1, Required:true, Text:"This role covers resource demand and workload planning. Describe your experience planning and balancing resource across competing demands."},
    {RoleKey:"res",  Order:2, Required:true, Text:"Give an example of managing a resourcing shortfall or conflict."}
);

/* SAMPLE ANSWERS — preview-only fallback shown on scrCompleted when a
   field was left blank. QIndex 0 = "why this preference" (Q1),
   QIndex 1 = "additional skills/experience/qualifications" (Q2). */
ClearCollect(
    colSampleAnswers,
    {RoleKey:"gov",  QIndex:0, Text:"This role is the closest fit to the activities I currently undertake. I have prepared papers and provided secretariat support for monthly programme boards over the past three years, and it is where I can add value most quickly."},
    {RoleKey:"gov",  QIndex:1, Text:"I currently maintain the portfolio decision log and produce the quarterly governance report used by the senior leadership team."},
    {RoleKey:"perf", QIndex:0, Text:"I am keen to build on my reporting experience and believe this role makes the best use of my analytical skills. I see it as a strong development step."},
    {RoleKey:"perf", QIndex:1, Text:"I have supported delivery confidence assessments and maintained benefits trackers for two large capital programmes, and used milestone trend data to recommend re-sequencing two dependent workstreams."},
    {RoleKey:"risk", QIndex:0, Text:"Risk and dependency management aligns with a specific area of interest for me and builds on the registers I already help maintain."},
    {RoleKey:"risk", QIndex:1, Text:"I hold the APM Project Risk Management certificate and have facilitated quarterly risk reviews for the area programme."}
);

/* ===================================================================
   4) ELIGIBILITY + WORKING RANKS  ->  Dataverse tables: Eligibility (set
      per person) joined to Roles. colRanks is the editable Stage-1 model
      and is the Items source for the scrForm gallery.
      Seeded with dc.html seed ranks [1,1,2,3,4] — note the DELIBERATE
      duplicate (gov & perf both = 1) to demonstrate validation.
      Count is per-person; do NOT hardcode five downstream.
   =================================================================== */
ClearCollect(
    colRanks,
    {RoleKey:"gov",  RoleName:"Governance & Decision Support", ShortDescription:"Boards, decisions and portfolio governance.",        Rank:1},
    {RoleKey:"perf", RoleName:"Performance & Reporting Control", ShortDescription:"Delivery confidence, reporting and data management.", Rank:1},
    {RoleKey:"stake",RoleName:"Stakeholder Management",          ShortDescription:"Supplier and stakeholder relationships.",            Rank:2},
    {RoleKey:"risk", RoleName:"Risk & Dependency Management",    ShortDescription:"Risk, issue and dependency registers.",              Rank:3},
    {RoleKey:"res",  RoleName:"Resource Management",             ShortDescription:"Resource demand and workload planning.",             Rank:4}
);

/* Seed the Stage-1 error list literally for the duplicate seed ranks
   [1,1,2,3,4] (rank 1 is used twice). scrForm > drpRank.OnChange
   recomputes it dynamically on every change — kept literal here so
   App.OnStart always compiles. */
ClearCollect(
    colFormErrors,
    {Msg: "Rank 1 has been selected for more than one role. Each role must have a unique rank."}
);

/* ===================================================================
   5) LOCKED RANKING (Stage 1 output)  ->  Dataverse table: Preferences
      Seeded here with the CANONICAL order [1,2,4,3,5] -> gov, perf, risk,
      stake, res, so scrReview / scrCompleted render content on first
      preview. The real flow rebuilds this from colRanks at Stage-1 lock.
   =================================================================== */
ClearCollect(
    colLockedRanking,
    {Rank:1, RoleKey:"gov",  RoleName:"Governance & Decision Support", ShortDescription:"Boards, decisions and portfolio governance."},
    {Rank:2, RoleKey:"perf", RoleName:"Performance & Reporting Control", ShortDescription:"Delivery confidence, reporting and data management."},
    {Rank:3, RoleKey:"risk", RoleName:"Risk & Dependency Management",    ShortDescription:"Risk, issue and dependency registers."},
    {Rank:4, RoleKey:"stake",RoleName:"Stakeholder Management",          ShortDescription:"Supplier and stakeholder relationships."},
    {Rank:5, RoleKey:"res",  RoleName:"Resource Management",             ShortDescription:"Resource demand and workload planning."}
);

/* ===================================================================
   6) STAGE-2 ANSWERS (TOP THREE preferences)  ->  Dataverse table:
      PreferenceResponses. Workstream 7 requirement (03.07.26): the SAME
      two branched questions are asked for each of the top 3 preferences:
        Q1 (QIndex 0) — why this role is your first/second/third
                        preference (ordinal swapped per section).
        Q2 (QIndex 1) — additional skills/experience/qualifications.
      Each answer is limited to 150 WORDS (enforced on scrQuestions via
      the WordCount field patched on change + submit gating).
      Rebuilt from colRanks at Stage-1 lock (scrForm). Seeded literally
      here (top 3 of the canonical locked order: gov, perf, risk).
   =================================================================== */
ClearCollect(
    colAnswers,
    {RoleKey:"gov",  RoleName:"Governance & Decision Support",   Ordinal:"first",  RankLabel:"Top choice · Rank 1",    QIndex:0, Required:true, WordCount:0, Answer:"", QuestionText:"Please provide a brief explanation as to why you have selected this role as your first preference. For example; do you think this role aligns best with the activities you currently undertake? Will this role make the best use of your existing relationships? Do you think this role will align best with a specific area of interest e.g. Carbon? Any information provided will be used to inform the outcome of this process where possible."},
    {RoleKey:"gov",  RoleName:"Governance & Decision Support",   Ordinal:"first",  RankLabel:"Top choice · Rank 1",    QIndex:1, Required:true, WordCount:0, Answer:"", QuestionText:"Please use this space to provide any additional information on skills, experience or qualifications relevant to this role that you would like us to be aware of. Any information provided will be used to inform the outcome of this process where possible."},
    {RoleKey:"perf", RoleName:"Performance & Reporting Control", Ordinal:"second", RankLabel:"Second choice · Rank 2", QIndex:0, Required:true, WordCount:0, Answer:"", QuestionText:"Please provide a brief explanation as to why you have selected this role as your second preference. For example; do you think this role aligns best with the activities you currently undertake? Will this role make the best use of your existing relationships? Do you think this role will align best with a specific area of interest e.g. Carbon? Any information provided will be used to inform the outcome of this process where possible."},
    {RoleKey:"perf", RoleName:"Performance & Reporting Control", Ordinal:"second", RankLabel:"Second choice · Rank 2", QIndex:1, Required:true, WordCount:0, Answer:"", QuestionText:"Please use this space to provide any additional information on skills, experience or qualifications relevant to this role that you would like us to be aware of. Any information provided will be used to inform the outcome of this process where possible."},
    {RoleKey:"risk", RoleName:"Risk & Dependency Management",    Ordinal:"third",  RankLabel:"Third choice · Rank 3",  QIndex:0, Required:true, WordCount:0, Answer:"", QuestionText:"Please provide a brief explanation as to why you have selected this role as your third preference. For example; do you think this role aligns best with the activities you currently undertake? Will this role make the best use of your existing relationships? Do you think this role will align best with a specific area of interest e.g. Carbon? Any information provided will be used to inform the outcome of this process where possible."},
    {RoleKey:"risk", RoleName:"Risk & Dependency Management",    Ordinal:"third",  RankLabel:"Third choice · Rank 3",  QIndex:1, Required:true, WordCount:0, Answer:"", QuestionText:"Please use this space to provide any additional information on skills, experience or qualifications relevant to this role that you would like us to be aware of. Any information provided will be used to inform the outcome of this process where possible."}
);

/* ===================================================================
   7) ADMIN OVERVIEW — no offline seed any more. The admin screens build
      colAllStaff / colOverviewRows from Dataverse in their "Refresh data"
      buttons (paste/admin-rebuild.powerfx), and a literal seed here with
      a different shape would only clash with that at author time.
      The admin pages need the Dataverse OnStart.
   =================================================================== */

/* ===================================================================
   8) STAGE / LOCK FLAGS  (mirror the dc.html state machine)
   =================================================================== */
Set(varStage1Submitted, false);
Set(varStage2Submitted, false);
Set(varStage1Date, "25/06/2026");
Set(varStage2Date, "25/06/2026");
Set(varDetailRoleKey, "gov");
Set(varDetailOrigin, "form");
Set(varSelectedOverviewId, Blank());

/* ===================================================================
   9) ROLE ALIGNMENT (Phase 2) — offline/demo seed
      Mirrors the shape the Dataverse OnStart builds from
      'RolePreference Alignments', so scrAlignment / scrRejection /
      scrAlignLocked render with no data source attached.
      Set varAlignPublished to false to preview the "not yet open"
      state of the landing card.
      LAYOUT PREVIEW ONLY: with no data source attached there is no
      Alignments row to Patch, so "Yes, accept role" and "Yes, submit"
      will error. Use the Dataverse OnStart to exercise the writes.
   =================================================================== */
Set(varAlignRole, "Governance & Decision Support");
Set(
    varAlignReason,
    "Placeholder reasoning — Kate and Claire supply the final 150 words in the PAB-6118 spreadsheet. " &
    "Your ranking, your supporting answers and the shape of the new structure were all considered together when this role was matched to you. " &
    "You ranked this role as your first preference and described substantial board secretariat and action-tracking experience, which maps directly onto the accountabilities of the role. " &
    "The panel also weighed the number of posts available against the preferences expressed across the whole area, and the balance of skills the new team needs from day one. " &
    "On that basis this role is the best available match for your experience and for the programme, and it keeps you working with the relationships you have already built."
);
Set(varAlignDecision, "");
Set(varAlignReasonsText, "");
Set(varAlignComments, "");
Set(varAlignStatus, "");
Set(varAlignDate, "");
Set(varAlignPublished, true);
Set(varAlignSubmitted, false);
ClearCollect(
    colRejectReasonList,
    {Idx: 1, Reason: "Failure to follow our processes"},
    {Idx: 2, Reason: "Discrimination"}
);
ClearCollect(
    colRejectReasons,
    ForAll(colRejectReasonList As m, {Idx: m.Idx, Reason: m.Reason, Chosen: false})
);
Set(varAlignDraftSaved, false);

/* ===================================================================
   10) CONFIRMATION EMAIL — same builder as section 4c of
       App_OnStart.dataverse.powerfx (collections only, no data source),
       so the Accept / Reject buttons' formulas bind offline too.
   =================================================================== */
/* ---- 4c) CONFIRMATION EMAIL (change request 23.09.26) --------------------
   When someone accepts or rejects their aligned role, an email goes to them
   with their line manager and aurora@environment-agency.gov.uk on copy. The
   send itself is in btnConfirmAccept (scrAlignment) and btnConfirmReject
   (scrRejection), through the Office 365 Outlook connector - add that data
   source first. It goes from the person's own mailbox, so a copy also sits in
   their Sent Items.

   Only the HTML is built here, and only from collections this OnStart has
   already loaded - this block reads no data source, so unlike section 4b it
   cannot take the rule down. The line manager's address is looked up in the
   buttons at send time for the same reason: LineManagerEmail is a new column
   on People, and a name that fails to bind in OnStart breaks the whole app;
   in a button it can only break that button.

   Placeholders the buttons fill in at send time:
     {{DATE}}      date of the decision
     {{REASONS}}   the ticked rejection reasons, as <li> items   (rejected only)
     {{COMMENTS}}  the further-information text, already escaped  (rejected only)
   Every piece of free text is escaped (& < >) so an answer containing "<"
   cannot break the layout. HTML attributes use single quotes, so nothing
   inside these Power Fx strings needs its double quotes doubled. */
Set(
    varEmailPrefsHtml,
    "<div style='font-size:12px;letter-spacing:1.5px;font-weight:bold;color:#5B6670;margin:26px 0 8px 0;'>YOUR RANKED PREFERENCES</div>"
    & "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='border-collapse:collapse;border:1px solid #DCE2E8;'>"
    & Concat(
        colLockedRanking As r,
        "<tr><td style='width:44px;padding:8px 0;text-align:center;border-bottom:1px solid #DCE2E8;background:#F4F7F9;color:#002B54;font-weight:bold;'>" & r.Rank & "</td>"
        & "<td style='padding:8px 12px;border-bottom:1px solid #DCE2E8;'>" & Substitute(Substitute(Substitute(r.RoleName, "&", "&amp;"), "<", "&lt;"), ">", "&gt;") & "</td></tr>"
    )
    & "</table>"
    & "<div style='font-size:12px;letter-spacing:1.5px;font-weight:bold;color:#5B6670;margin:26px 0 8px 0;'>YOUR SUPPORTING ANSWERS (TOP THREE PREFERENCES)</div>"
    & Concat(
        FirstN(colLockedRanking, 3) As r,
        "<div style='border:1px solid #DCE2E8;margin:0 0 12px 0;'>"
        & "<div style='background:#F4F7F9;border-bottom:1px solid #DCE2E8;padding:8px 12px;color:#002B54;font-weight:bold;'>Preference " & r.Rank & " &middot; " & Substitute(Substitute(Substitute(r.RoleName, "&", "&amp;"), "<", "&lt;"), ">", "&gt;") & "</div>"
        & Concat(
            Sort(Filter(colAnswers, RoleKey = r.RoleKey), QIndex, SortOrder.Ascending) As q,
            "<div style='padding:10px 12px 0 12px;font-size:13px;font-weight:bold;color:#5B6670;'>" & If(q.QIndex = 0, "Why you chose this role", "Additional skills, experience or qualifications") & "</div>"
            & "<div style='padding:4px 12px 10px 12px;'>"
            & If(
                IsBlank(Trim(q.Answer)),
                "<i style='color:#5B6670;'>No answer given</i>",
                Substitute(Substitute(Substitute(Substitute(Substitute(q.Answer, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), Char(13), ""), Char(10), "<br>")
            )
            & "</div>"
        )
        & "</div>"
    )
);
/* One shell for both emails. {{TITLE}}, {{STRIP}}, {{INTRO}} and {{DECISION}}
   are swapped out just below; {{DATE}}, {{REASONS}} and {{COMMENTS}} survive
   into varEmailAccepted / varEmailRejected for the buttons. */
Set(
    varEmailShell,
    With(
        {
            nm: Substitute(Substitute(Substitute(varUser.Name, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"),
            ar: Substitute(Substitute(Substitute(varUser.Area, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"),
            rl: Substitute(Substitute(Substitute(varAlignRole, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"),
            td1: "<td style='width:150px;padding:7px 12px;border-bottom:1px solid #DCE2E8;background:#F4F7F9;color:#5B6670;font-size:13px;'>",
            td2: "<td style='padding:7px 12px;border-bottom:1px solid #DCE2E8;'>"
        },
        "<div style='margin:0;padding:24px 12px;background:#F2F5F7;font-family:Segoe UI,Arial,sans-serif;font-size:15px;line-height:1.5;color:#1F2933;'>"
        & "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='max-width:640px;margin:0 auto;background:#FFFFFF;border:1px solid #DCE2E8;border-collapse:collapse;'>"
        & "<tr><td style='background:#002B54;padding:22px 28px;'>"
        & "<div style='font-size:12px;letter-spacing:2px;font-weight:bold;color:#BBE2F4;'>AURORA &middot; ROLE ALIGNMENT</div>"
        & "<div style='font-size:24px;font-weight:bold;color:#FFFFFF;margin-top:6px;'>{{TITLE}}</div>"
        & "</td></tr>"
        & "<tr><td style='background:{{STRIP}};height:5px;line-height:5px;font-size:0;'>&nbsp;</td></tr>"
        & "<tr><td style='padding:24px 28px;'>"
        & "<p style='margin:0 0 12px 0;'>Hello " & nm & ",</p>"
        & "<p style='margin:0 0 18px 0;'>{{INTRO}} A copy has been sent to your line manager and to the Aurora team.</p>"
        & "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='border-collapse:collapse;border:1px solid #DCE2E8;'>"
        & "<tr>" & td1 & "Name</td>" & td2 & nm & "</td></tr>"
        & "<tr>" & td1 & "Employee ID</td>" & td2 & varUser.EmpId & "</td></tr>"
        & "<tr>" & td1 & "Grade</td>" & td2 & varUser.Grade & "</td></tr>"
        & "<tr>" & td1 & "Area</td>" & td2 & ar & "</td></tr>"
        & "<tr>" & td1 & "Aligned role</td>" & td2 & "<b style='color:#002B54;'>" & rl & "</b></td></tr>"
        & "<tr>" & td1 & "Date of response</td>" & td2 & "{{DATE}}</td></tr>"
        & "</table>"
        & "{{DECISION}}"
        & varEmailPrefsHtml
        & "</td></tr>"
        & "<tr><td style='background:#F4F7F9;border-top:1px solid #DCE2E8;padding:14px 28px;font-size:12px;color:#5B6670;'>"
        & "Sent automatically by the Aurora Role Preference app when you submitted your response. "
        & "Questions? Contact <a href='mailto:aurora@environment-agency.gov.uk' style='color:#0E6FA8;'>aurora@environment-agency.gov.uk</a>."
        & "</td></tr>"
        & "</table></div>"
    )
);
Set(
    varEmailAccepted,
    Substitute(
        Substitute(
            Substitute(
                Substitute(varEmailShell, "{{TITLE}}", "Role accepted"),
                "{{STRIP}}", "#008531"
            ),
            "{{INTRO}}", "You accepted your aligned role in the Aurora Role Preference app. This email is your record of that response."
        ),
        "{{DECISION}}",
        "<div style='margin:18px 0 0 0;padding:14px 18px;background:#E4F3EA;border:1px solid #C9E7D4;border-left:4px solid #008531;'>"
        & "<div style='font-weight:bold;color:#006B27;'>ACCEPTED</div>"
        & "<div style='margin-top:4px;'>Your acceptance has been recorded and your response is now locked. "
        & "Your HR Business Partner will be in touch about next steps and timings. "
        & "If anything here looks wrong, contact <a href='mailto:aurora@environment-agency.gov.uk' style='color:#0E6FA8;'>aurora@environment-agency.gov.uk</a> straight away.</div>"
        & "</div>"
    )
);
Set(
    varEmailRejected,
    Substitute(
        Substitute(
            Substitute(
                Substitute(varEmailShell, "{{TITLE}}", "Role rejected"),
                "{{STRIP}}", "#0E6FA8"
            ),
            "{{INTRO}}", "You rejected your aligned role in the Aurora Role Preference app. This email is your record of that response and the reasons you gave."
        ),
        "{{DECISION}}",
        "<div style='margin:18px 0 0 0;padding:14px 18px;background:#F4F7F9;border:1px solid #DCE2E8;border-left:4px solid #002B54;'>"
        & "<div style='font-weight:bold;color:#002B54;'>REJECTED</div>"
        & "<div style='font-size:12px;letter-spacing:1.5px;font-weight:bold;color:#5B6670;margin-top:12px;'>YOUR REASONS</div>"
        & "<ul style='margin:6px 0 0 0;padding-left:20px;'>{{REASONS}}</ul>"
        & "<div style='font-size:12px;letter-spacing:1.5px;font-weight:bold;color:#5B6670;margin-top:12px;'>FURTHER INFORMATION</div>"
        & "<div style='margin-top:4px;'>{{COMMENTS}}</div>"
        & "</div>"
        & "<p style='margin:14px 0 0 0;'>Your rejection has been recorded and your response is now locked. "
        & "Your line manager will review your rejection information and will be in touch to discuss it with you. "
        & "If anything here looks wrong, contact them straight away.</p>"
    )
)
