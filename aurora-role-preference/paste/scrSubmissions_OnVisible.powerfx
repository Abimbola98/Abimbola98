/* =============================================================================
   scrSubmissions -> OnVisible   (screen property: paste into the formula bar)
   ALSO paste this exact text into btnRefreshSubs.OnSelect on this screen. The
   two admin screens each rebuild for themselves; neither may assume the other
   was visited first.
   ============================================================================ */
Refresh('RolePreference Preferences');
Refresh('RolePreference PreferenceResponses');
Refresh('RolePreference People');
Refresh('RolePreference Roles');
Set(varSelectedOverviewId, Blank());

/* ---- 5) ALL-STAFF completion tracker (admin) -----------------------------
   Built FIRST, straight from People (about 105 rows, comfortably inside any
   data row limit). Status is exactly one of Completed / In progress /
   Not started, so the counters always reconcile. */
If(
    varIsAdmin,
    ClearCollect(
        colAllStaff,
        ForAll(
            'RolePreference People' As p,
            {
                EmpId: p.EmployeeID,
                Name: p.Name,
                Grade: p.Grade,
                Area: p.Area,
                Status: If(
                    CountRows(Filter('RolePreference PreferenceResponses', EmployeeID = p.EmployeeID And Stage2Status = "Submitted")) > 0, "Completed",
                    CountRows(Filter('RolePreference Preferences', EmployeeID = p.EmployeeID And Stage1Status <> "Withdrawn")) > 0, "In progress",
                    "Not started"
                ),
                SubmittedOn: If(
                    CountRows(Filter('RolePreference Preferences', EmployeeID = p.EmployeeID)) > 0,
                    Text(LookUp('RolePreference Preferences', EmployeeID = p.EmployeeID).SubmittedOn, "dd/mm/yyyy"),
                    ""
                ),
                Ord: If(
                    CountRows(Filter('RolePreference PreferenceResponses', EmployeeID = p.EmployeeID And Stage2Status = "Submitted")) > 0, 3,
                    CountRows(Filter('RolePreference Preferences', EmployeeID = p.EmployeeID And Stage1Status <> "Withdrawn")) > 0, 2,
                    1
                )
            }
        )
    )
);
If(varIsAdmin, Set(varCountAll, CountRows(colAllStaff)));
If(varIsAdmin, Set(varCountDone, CountRows(Filter(colAllStaff, Status = "Completed"))));
/* Outstanding by subtraction, so Completed + Outstanding equals All by
   arithmetic and cannot drift from the tab filters. */
If(varIsAdmin, Set(varCountOutstanding, varCountAll - varCountDone));

/* ---- 5b) Submissions detail (admin) --------------------------------------
   Derived from colAllStaff, NOT from Distinct() over the Preferences table.
   Distinct is not delegable on Dataverse, so it only ever saw the first page
   of rows (default data row limit 500). With ~105 people ranking up to 9 roles
   each that is ~945 preference rows, and a NEW submission - written to the end
   of the table - fell outside the page that was fetched. That is why a fresh
   submission did not appear until the whole app was reloaded.
   Every lookup below is an equality filter, which Dataverse can delegate.

   The six Stage-2 answers are flattened to R1a/R1b/R2a/R2b/R3a/R3b so
   scrSubmissions can render them in a fixed Rank1-Q1, Rank1-Q2, Rank2-Q1 ...
   order without Concat over a nested table. */
If(
    varIsAdmin,
    ClearCollect(
        colOverviewRows,
        ForAll(
            Filter(colAllStaff, Status <> "Not started") As d,
            With(
                {
                    k1: LookUp('RolePreference Preferences', EmployeeID = d.EmpId And Rank = 1).RoleKey,
                    k2: LookUp('RolePreference Preferences', EmployeeID = d.EmpId And Rank = 2).RoleKey,
                    k3: LookUp('RolePreference Preferences', EmployeeID = d.EmpId And Rank = 3).RoleKey,
                    dt: LookUp('RolePreference Preferences', EmployeeID = d.EmpId).SubmittedOn
                },
                {
                    Id: d.EmpId,
                    EmpId: d.EmpId,
                    Name: d.Name,
                    Grade: d.Grade,
                    Area: d.Area,
                    SortDate: dt,
                    Date: Text(dt, "dd/mm/yyyy"),
                    /* yyyy-mm-dd sorts lexicographically = chronologically, so
                       the sort dropdown can treat it as just another text key. */
                    SortDateText: Text(dt, "yyyy-mm-dd hh:mm"),
                    Stage2: If(d.Status = "Completed", "Submitted", "Outstanding"),
                    Roles: ForAll(
                        Sort(Filter('RolePreference Preferences', EmployeeID = d.EmpId), Rank, SortOrder.Ascending) As p,
                        {Order: p.Rank, RoleName: Coalesce(LookUp('RolePreference Roles', RoleKey = p.RoleKey).RoleName, "[missing role: " & p.RoleKey & "]")}
                    ),
                    R1Name: If(IsBlank(k1), Blank(), Coalesce(LookUp('RolePreference Roles', RoleKey = k1).RoleName, "[missing role: " & k1 & "]")),
                    R1a: LookUp('RolePreference PreferenceResponses', EmployeeID = d.EmpId And RoleKey = k1 And QIndex = 0).ResponseText,
                    R1b: LookUp('RolePreference PreferenceResponses', EmployeeID = d.EmpId And RoleKey = k1 And QIndex = 1).ResponseText,
                    R2Name: If(IsBlank(k2), Blank(), Coalesce(LookUp('RolePreference Roles', RoleKey = k2).RoleName, "[missing role: " & k2 & "]")),
                    R2a: LookUp('RolePreference PreferenceResponses', EmployeeID = d.EmpId And RoleKey = k2 And QIndex = 0).ResponseText,
                    R2b: LookUp('RolePreference PreferenceResponses', EmployeeID = d.EmpId And RoleKey = k2 And QIndex = 1).ResponseText,
                    R3Name: If(IsBlank(k3), Blank(), Coalesce(LookUp('RolePreference Roles', RoleKey = k3).RoleName, "[missing role: " & k3 & "]")),
                    R3a: LookUp('RolePreference PreferenceResponses', EmployeeID = d.EmpId And RoleKey = k3 And QIndex = 0).ResponseText,
                    R3b: LookUp('RolePreference PreferenceResponses', EmployeeID = d.EmpId And RoleKey = k3 And QIndex = 1).ResponseText
                }
            )
        )
    )
);
/* Area options for the admin filter dropdowns. Distinct() over the in-memory
   colAllStaff is safe - the delegation trap is Distinct over a Dataverse table. */
If(varIsAdmin, ClearCollect(colAreaOptions, {Value: "All areas"}));
If(
    varIsAdmin,
    Collect(
        colAreaOptions,
        ForAll(Sort(Distinct(Filter(colAllStaff, Not IsBlank(Area)), Area), Value, SortOrder.Ascending) As a, {Value: a.Value})
    )
);
Set(varAdminRefreshedAt, Text(Now(), "HH:mm:ss"))