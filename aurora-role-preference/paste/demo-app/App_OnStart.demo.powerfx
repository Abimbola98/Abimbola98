    {EmployeeID: "900106", AssignedRoleName: "Advisor - Programme Office - South", AssignedRoleKey: "R06", AssignedReason: "", Decision: "Accepted", RejectReasons: "", RejectComments: "", AlignmentStatus: "Submitted", DecisionOn: DateTime(2026, 10, 6, 12, 33, 0), DecisionBy: "felix.brannigan@example.com", LineManagerEmail: "presenter"},
    {EmployeeID: "900107", AssignedRoleName: "Senior Advisor - Risk & Assurance", AssignedRoleKey: "R15", AssignedReason: "", Decision: "Rejected", RejectReasons: "Failure to follow our processes", RejectComments: "I do not feel my supporting answers were taken into account. I explained my experience in detail, but I have been aligned to a role I ranked near the bottom of my list. I would like to understand how my answers were used when roles were allocated, and whether my first or second preference was considered before this decision was made.", AlignmentStatus: "Submitted", DecisionOn: DateTime(2026, 10, 9, 11, 50, 0), DecisionBy: "grace.adeyemi@example.com", LineManagerEmail: "gwen.lloyd-jones@example.com"},
    {EmployeeID: "900108", AssignedRoleName: "Officer - Programme Office - North", AssignedRoleKey: "R01", AssignedReason: "", Decision: "Accepted", RejectReasons: "", RejectComments: "", AlignmentStatus: "Submitted", DecisionOn: DateTime(2026, 10, 13, 12, 29, 0), DecisionBy: "hamish.rowntree@example.com", LineManagerEmail: "jordan.ellis@example.com"},
    {EmployeeID: "900109", AssignedRoleName: "Senior Advisor - Risk & Assurance", AssignedRoleKey: "R15", AssignedReason: "", Decision: "Rejected", RejectReasons: "Failure to follow our processes", RejectComments: "The aligned role would change where and how I work quite significantly, and I was not asked about this before the decision was made. I understood that this would be considered. I would welcome a conversation about whether a role closer to my current work could be offered.", AlignmentStatus: "Submitted", DecisionOn: DateTime(2026, 10, 15, 11, 30, 0), DecisionBy: "isla.petrovic@example.com", LineManagerEmail: "tom.akintola@example.com"},
    {EmployeeID: "900110", AssignedRoleName: "Officer - Delivery Hub - Midlands & East", AssignedRoleKey: "R04", AssignedReason: "", Decision: "Accepted", RejectReasons: "", RejectComments: "", AlignmentStatus: "Submitted", DecisionOn: DateTime(2026, 10, 8, 8, 26, 0), DecisionBy: "jamal.osei@example.com", LineManagerEmail: "sanjay.mehta@example.com"},
